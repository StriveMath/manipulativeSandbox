# Provider keys for the convert-and-export panel.
#
# Read by the Vite dev server only (see server/api-plugin.js). They have no
# VITE_ prefix on purpose, so they never reach the browser bundle. Set one or
# both; the model dropdown only offers models whose provider has a key.
#
# Copy to .env and fill in.

OPENAI_API_KEY="sk-proj-example"
ANTHROPIC_API_KEY="sk-proj-example"